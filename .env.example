# ==============================================================================
# Configurações Globais - ToggleMaster Local
# ==============================================================================

# Chave mestra administrativa para gerar tokens no auth-service
MASTER_KEY=admin-secreto-123

# Chave de serviço que o evaluation-service usará para chamar flag-service e targeting-service
# (Você pode preencher aqui após criar a chave no auth-service)
SERVICE_API_KEY=

# ==============================================================================
# Configurações AWS (Fila SQS e Credenciais)
# ==============================================================================
AWS_REGION=us-east-1
AWS_SQS_URL=

# Credenciais da AWS (preencha com suas credenciais ou deixe com os valores padrão para teste local)
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey
AWS_SESSION_TOKEN=

# Nome da tabela DynamoDB (no contêiner dynamodb-local)
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics
